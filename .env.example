# Copy to .env (git-ignored), fill in, then: set -a; source .env; set +a
# MinIO root credentials (Terraform provider + kk-payments receipt writes)
MINIO_USER=
MINIO_PASSWORD=
# Terraform's S3 backend reads these names — set them to the same MinIO values
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Docker Hub (private repo canyingi/kk-payments); use an access token, not your password
DOCKERHUB_USER=
DOCKERHUB_TOKEN=
