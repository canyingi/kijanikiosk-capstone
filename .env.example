# Copy to .env (git ignores it), fill in the values, then load it with:
#   set -a; source .env; set +a

# MinIO - stores my Terraform state (the S3 backend reads these two names)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# kk-payments application secrets (same keys as my Week 9 Secret lab; dev values are fine locally)
KK_DB_PASSWORD=
KK_STRIPE_API_KEY=
KK_JWT_SECRET=

# Docker Hub - private repo canyingi/kk-payments. Use an access token, not your password.
DOCKERHUB_USER=
DOCKERHUB_TOKEN=
