# Documents which keys the kk-payments-secrets Secret must contain. It holds NO real values.
# The real Secret is created by infra/ansible/configure-environments.yml from environment
# variables, so the values never end up in git. (This is the .example pattern from Week 9.)
apiVersion: v1
kind: Secret
metadata:
  name: kk-payments-secrets
type: Opaque
stringData:
  DB_PASSWORD: ""            # from KK_DB_PASSWORD
  STRIPE_API_KEY: ""         # from KK_STRIPE_API_KEY
  JWT_SECRET: ""             # from KK_JWT_SECRET
  AWS_ACCESS_KEY_ID: ""      # S3RVER locally (serverless-s3-local); a real key in AWS
  AWS_SECRET_ACCESS_KEY: ""  # S3RVER locally
